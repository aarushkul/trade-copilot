# Copy this file to .env and fill in your Schwab developer app credentials.
# Get them from developer.schwab.com once your app status is "Ready for Use".
SCHWAB_APP_KEY=your-app-key-here
SCHWAB_APP_SECRET=your-app-secret-here
# Must match the callback URL configured on your Schwab developer app exactly.
SCHWAB_CALLBACK_URL=https://127.0.0.1:8182
